rules_version = '2';
// SNIPPET ONLY — merge into the shared project rules. Do not deploy this file alone.
// Collections below are Autora. Keep every sister-app match from Yoga/Wardrobe/Workout/Food.

match /autora_listings/{id} {
  allow read: if true;
  allow create, update: if request.auth != null
    && request.resource.data.sellerId == request.auth.uid;
  allow delete: if request.auth != null
    && resource.data.sellerId == request.auth.uid;
}

match /autora_users/{uid} {
  allow read: if true;
  allow write: if request.auth != null && request.auth.uid == uid;
}

match /autora_favorites/{id} {
  allow read, write: if request.auth != null
    && request.resource.data.userId == request.auth.uid;
}

match /autora_saved_searches/{id} {
  allow read: if request.auth != null
    && resource.data.userId == request.auth.uid;
  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid;
  allow update, delete: if request.auth != null
    && resource.data.userId == request.auth.uid;
}

match /autora_chats/{id} {
  allow read, update, delete: if request.auth != null
    && request.auth.uid in resource.data.participantIds;
  allow create: if request.auth != null
    && request.auth.uid in request.resource.data.participantIds;
}

match /autora_messages/{id} {
  allow read, write: if request.auth != null
    && request.auth.uid in resource.data.participantIds;
}

match /autora_reports/{id} {
  allow create: if request.auth != null;
  allow read, update, delete: if false;
}

match /autora_blocks/{id} {
  allow read, write: if request.auth != null
    && request.resource.data.userId == request.auth.uid;
}

match /autora_fx/{id} {
  allow read: if true;
  allow write: if false;
}

match /autora_bumps/{id} {
  allow read, write: if request.auth != null;
}
